rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidFinancialsCache(data) {
      return data.keys().hasAll(['ticker', 'updatedAt']) 
             && data.ticker is string 
             && data.updatedAt is string
             && (data.keys().hasOnly(['ticker', 'companyName', 'cik', 'netIncome', 'revenues', 'assets', 'liabilities', 'updatedAt']))
             && (!('companyName' in data) || data.companyName is string)
             && (!('cik' in data) || data.cik is string)
             && (!('netIncome' in data) || data.netIncome is number)
             && (!('revenues' in data) || data.revenues is number)
             && (!('assets' in data) || data.assets is number)
             && (!('liabilities' in data) || data.liabilities is number);
    }

    match /financialsCache/{ticker} {
      allow read: if true;
      allow create: if isValidId(ticker) && isValidFinancialsCache(incoming());
      allow update: if isValidId(ticker) && isValidFinancialsCache(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt', 'netIncome', 'revenues', 'assets', 'liabilities']);
    }
  }
}
