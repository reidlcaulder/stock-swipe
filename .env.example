# Copy to .env.local (gitignored) and fill in.

# Supabase project URL and publishable key (Project Settings -> API Keys).
# Safe to ship in the app: every table is protected by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Set to true to run the app on bundled mock data with no backend (any 6-digit code signs in).
EXPO_PUBLIC_USE_MOCKS=false
